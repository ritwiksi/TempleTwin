# Copy this file to .env on the Vultr server and fill in real values.
# Never commit the populated .env file.

VITE_CESIUM_ION_TOKEN=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Ask Temple Twin / Snowflake Cortex
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=UTIL_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=TEMPLE_TWIN_APP
SNOWFLAKE_CORTEX_MODEL=llama3.1-8b

# Keep false in production. Turn on temporarily only for troubleshooting.
ENABLE_DIAGNOSTICS=false
